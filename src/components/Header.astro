---
import { site, nav } from '../data/site';

const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<header class="border-b border-grout bg-white/90">
  <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-x-6 gap-y-2 px-4 py-3">
    <a href="/" class="flex items-center gap-2 font-bold tracking-tight">
      <img src="/favicon.svg" alt="" width="24" height="24" />
      <span>{site.name}</span>
    </a>
    <nav aria-label="Primary">
      <ul class="flex flex-wrap gap-x-5 gap-y-1 text-sm font-medium">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class="border-b-2 border-transparent py-1 hover:border-pool aria-[current=page]:border-rope"
              >
                {item.label}
              </a>
            </li>
          ))
        }
        {
          site.resume && (
            <li>
              <a href={site.resume} class="border-b-2 border-transparent py-1 hover:border-pool">
                Resume
              </a>
            </li>
          )
        }
      </ul>
    </nav>
  </div>
</header>
