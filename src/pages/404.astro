---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="This page doesn't exist.">
  <section class="bg-tiles border-b border-grout">
    <div class="mx-auto max-w-5xl px-4 py-24 text-center">
      <p class="font-mono text-sm font-bold uppercase tracking-widest text-rope">No lifeguard on duty</p>
      <h1 class="mt-2 text-4xl font-extrabold tracking-tight">404: out of your depth</h1>
      <p class="mt-4 text-deep-2">That page doesn't exist.</p>
      <p class="mt-8">
        <a href="/" class="rounded-md bg-pool px-5 py-2.5 font-semibold text-white hover:bg-deep">Back to the shallow end</a>
      </p>
    </div>
  </section>
</Base>
