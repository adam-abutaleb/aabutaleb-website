---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---
<Base title="Projects" description="Software and quantitative projects, each with a short case study.">
  <section class="mx-auto max-w-5xl px-4 py-12">
    <h1 class="mb-2 text-3xl font-extrabold tracking-tight sm:text-4xl">Projects</h1>
    <p class="mb-8 max-w-prose text-deep-2">
      Each project has a short write-up: the problem, what I built, and what came of it.
    </p>
    <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        projects.map((project, i) => (
          <li>
            <ProjectCard project={project} lane={i + 1} />
          </li>
        ))
      }
    </ul>
  </section>
</Base>
