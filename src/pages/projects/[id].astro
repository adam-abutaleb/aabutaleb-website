---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { title, summary, tech, repo, demo, confirmed } = project.data;
const { Content } = await render(project);
---
<Base title={title} description={summary}>
  <article class="mx-auto max-w-5xl px-4 py-12">
    <p class="mb-4 text-sm"><a href="/projects/" class="text-pool underline underline-offset-4">&larr; All projects</a></p>
    <header class="mb-8 border-l-4 border-deep pl-4">
      <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl">{title}</h1>
      <p class="mt-3 max-w-prose text-lg text-deep-2">{summary}</p>
      {!confirmed && <p class="mt-2 text-sm font-semibold text-rope">Not yet confirmed for the portfolio</p>}
      {
        tech.length > 0 && (
          <ul class="mt-4 flex flex-wrap gap-2" aria-label="Tech used">
            {tech.map((t) => (
              <li class="rounded-full bg-shallow px-2.5 py-0.5 font-mono text-xs">{t}</li>
            ))}
          </ul>
        )
      }
      {
        (repo || demo) && (
          <p class="mt-4 flex gap-5 text-sm font-medium">
            {repo && <a href={repo} class="text-pool underline underline-offset-4">Source code</a>}
            {demo && <a href={demo} class="text-pool underline underline-offset-4">Live demo</a>}
          </p>
        )
      }
    </header>
    <div class="prose-pool">
      <Content />
    </div>
  </article>
</Base>
